{
  "schema_version": 1,
  "env": {},
  "phases": {
    "install": {
      "steps": [
        {
          "name": "queue-dependencies",
          "argv": [
            "pwsh",
            "-NoProfile",
            "-NonInteractive",
            "-Command",
            "npm ci --ignore-scripts"
          ],
          "cwd": "firefox-chatgpt-toolkit/userscripts/chatgpt-queue",
          "timeout_seconds": 180
        }
      ]
    },
    "verify": {
      "steps": [
        {
          "name": "queue-tests",
          "argv": [
            "{python}",
            "scripts/verify-project.py",
            "node-tests",
            "firefox-chatgpt-toolkit/userscripts/chatgpt-queue"
          ],
          "cwd": ".",
          "timeout_seconds": 180
        },
        {
          "name": "queue-syntax",
          "argv": [
            "node",
            "--check",
            "chatgpt-queue.user.js"
          ],
          "cwd": "firefox-chatgpt-toolkit/userscripts/chatgpt-queue",
          "timeout_seconds": 30
        },
        {
          "name": "capture-tests",
          "argv": [
            "{python}",
            "scripts/verify-project.py",
            "capture-tests"
          ],
          "cwd": ".",
          "timeout_seconds": 60
        },
        {
          "name": "documentation",
          "argv": [
            "{python}",
            "scripts/verify-project.py",
            "docs"
          ],
          "cwd": ".",
          "timeout_seconds": 30
        }
      ]
    }
  }
}
